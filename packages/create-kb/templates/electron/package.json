{
  "name": "{{packageName}}-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^41.10.6",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "com.example.{{projectName}}",
    "productName": "{{projectName}}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "fast-uri": "^3.1.0",
    "vite": "^6.4.3",
    "electron": "^41.10.6"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.1.1",
      "fast-uri": "^3.1.0",
      "vite": "^6.4.3"
    }
  },
  "dependencies": {}
}
