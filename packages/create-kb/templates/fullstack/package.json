{
  "name": "{{packageName}}",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"pnpm --filter web dev\" \"pnpm --filter api dev\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter api test",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "fast-uri": "^3.1.0",
    "vite": "^6.3.5",
    "electron": "^39.8.10"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.1.1",
      "fast-uri": "^3.1.0",
      "vite": "^6.3.5"
    }
  }
}
