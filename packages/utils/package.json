{
  "name": "@yuer678/kb-utils",
  "version": "0.2.0",
  "description": "通用 TS 工具函数库（格式化/时间/数组/对象/字符串/存储/正则/异步/DOM）",
  "license": "MIT",
  "author": "anyuer678",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anyuer678/kb-ui.git",
    "directory": "packages/utils"
  },
  "homepage": "https://anyuer678.github.io/kb-ui/",
  "bugs": {
    "url": "https://github.com/anyuer678/kb-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@kb/config": "workspace:*",
    "@types/node": "^26.6.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "js-yaml": "^4.1.1",
    "fast-uri": "^3.1.0",
    "vite": "^6.3.5"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.1.1",
      "fast-uri": "^3.1.0",
      "vite": "^6.3.5"
    }
  }
}
