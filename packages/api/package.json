{
  "name": "@kb/api",
  "version": "0.1.0",
  "description": "可复用的参考后端服务（Express + Zod）：分页/排序/搜索、树形懒加载、大列表，供组件演示、原型联调与本地 mock",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "start": "tsx src/start.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@kb/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
