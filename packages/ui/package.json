{
  "name": "kb-ui-vue",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js",
      "require": "./dist/resolver.cjs"
    },
    "./styles/*": "./dist/styles/*",
    "./global": {
      "types": "./dist/global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-styles.mjs && node scripts/build-global-types.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test --config visual/playwright.config.ts",
    "test:visual:update": "playwright test --config visual/playwright.config.ts --update-snapshots",
    "check-size": "node scripts/check-size.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\" --allow-empty-input"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
